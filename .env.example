# ---------------------------------------------------------------------------
# Uy Loyiha Studio — environment variables
# Copy to .env for local dev, or set the same names in your hosting platform
# (Railway). .env is git-ignored; NEVER commit real secrets.
# ---------------------------------------------------------------------------

# ---- Django core ----------------------------------------------------------
# REQUIRED in production (DEBUG off). Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# 'true' only for local development; keep 'false' in production.
DJANGO_DEBUG=true
# Comma-separated hosts, e.g. my-app.up.railway.app,www.example.com
# Optional: production auto-adds RAILWAY_PUBLIC_DOMAIN when set.
DJANGO_ALLOWED_HOSTS=
# Comma-separated https origins for cookie-carrying mutations (SPA + backend
# are same-origin, so usually not needed). e.g. https://my-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=
# Comma-separated origins allowed for cross-origin calls to the public API.
CORS_ALLOWED_ORIGINS=

# ---- Transport security (production) --------------------------------------
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# ---- Database -------------------------------------------------------------
# Optional: default is local sqlite (db.sqlite3). Railway Postgres provides
# DATABASE_URL automatically, e.g.
# postgres://user:pass@host:port/railway
DATABASE_URL=

# ---- AI assistant (Groq) --------------------------------------------------
# Optional: chat falls back to a deterministic offline engine when unset.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ---- AI house/product images ----------------------------------------------
# Optional: falls back to a built-in SVG preview when unset.
AI_IMAGE_API_KEY=
AI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
AI_IMAGE_MODEL=gpt-image-2
# Set '1' to force regeneration of cached previews.
OPENAI_FORCE_RENDER=0

# ---- Image storage: S3 ----------------------------------------------------
# Optional: unset for local disk. Set these to route uploaded images/drawings
# to S3 (bucket must allow public reads).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Telegram bot (separate standalone service, my_bot.py) ----------------
# Not used by the web app itself; only if you also deploy the aiogram bot.
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=

# ---- Frontend build-time (Vite) -------------------------------------------
# Single URL. Injected into the static bundle at build time; defaults to the
# partner store URL when unset.
VITE_STORE_URL=https://web-production-7ece6.up.railway.app/
